    "schedules": {
      "description": "Scheduled prompts (made by agents' tools or in the window).",
      "who": [
        "window",
        "cli",
        "bridge"
      ],
      "item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": ""

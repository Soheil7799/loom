      "who": [
        "window",
        "cli",
        "bridge:remote"
      ],
      "item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "`note`, or `error`"
          },
          "path": {
            "type": "string",
            "description": ""
          },
          "text": {
            "type": "string",
            "description": ""
          },
          "title": {
            "type": "string",
            "description": ""
          },
          "tags": {
            "type": "array",
            "description": ""
          },
          "links": {
            "type": "array",
            "description": ""
          },
          "backlinks": {
            "type": "array",
            "description": ""
          },
          "modified": {
            "type": "integer",
            "description": ""
          },
          "message": {
            "type": "string",
            "description": "an error's"
          }
        },

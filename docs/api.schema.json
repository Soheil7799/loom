  "commands": {
    "send": {
      "description": "A message to an agent, as typed in its chat. Bridges send no `!` commands.",
      "who": [
        "window",
        "cli",
        "bridge"
      ],
      "later": true,
      "params": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "description": "the agent's id"
          },
          "text": {
            "type": "string",
            "description": "the message (text or pictures are needed)"
          },
          "images": {
            "type": "array",
            "description": "pictures, base64, any format the UI reads"
          }
        },
        "required": [
          "agent"
        ]
      },
      "result": "{}"
    },

          "entry"
        ]
      },
      "result": "{}"
    },
    "set_mode": {
      "description": "An agent's permission mode. `bypassPermissions` from loom's window only.",
      "who": [
        "window",
        "cli",
        "bridge"
      ],
      "later": false,
      "params": {
        "type": "object",
        "properties": {
          "agent": {

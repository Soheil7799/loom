          "mode"
        ]
      },
      "result": "{}"
    },
    "rename": {
      "description": "Renames an agent (its own titles don't replace it then).",
      "who": [
        "window",
        "cli",
        "bridge"
      ],
      "later": false,
      "params": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "description": "the agent's id"
          },
          "title": {
            "type": "string",
            "description": "its new title"
          }
        },
        "required": [

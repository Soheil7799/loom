            "type": "string",
            "description": ""
          },
          "path": {
            "type": "string",
            "description": ""
          },
          "kind": {
            "type": "string",
            "description": "folder, note, file, error"
          },
          "count": {
            "type": "integer",
            "description": "a folder's entries"
          },
          "title": {
            "type": "string",
            "description": "a note's"
          },
          "size": {
            "type": "integer",
            "description": ""
          },
          "modified": {
            "type": "integer",
            "description": ""
          }
        },
        "required": [

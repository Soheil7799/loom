{
  "name": "loom-web",
  "private": true,
  "version": "0.0.0",
  "description": "loom's web page: a client of loom's core API (built to dist/, served by loom)",
  "type": "module",
  "scripts": {
    "types": "bun scripts/api-types.ts",
    "check": "bun scripts/api-types.ts && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && bun test",
    "build": "bun run check && bun --bun vite build",
    "dev": "bun --bun vite",
    "test": "bun test"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6",
    "svelte": "^5",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9",
    "vite": "^7"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "uqr": "^0.1.3"
  }
}
